# openmirror — everything here is optional. A provider with no key is simply not
# registered, so an install with only Perch configured is a complete install.

# --- server ---------------------------------------------------------------
OPENMIRROR_HOST=127.0.0.1
OPENMIRROR_PORT=8477
# Required if you move off loopback. This process runs commands on the machine.
OPENMIRROR_TOKEN=

# The only directory an agent session may read or write. Confinement is the
# one thing between a model and the rest of your disk, so keep it narrow.
OPENMIRROR_WORKSPACE=/home/you/code/project

# read_only | ask | auto_edit | trusted | unrestricted
OPENMIRROR_APPROVAL_MODE=ask

# Give the agent the whole filesystem rather than confining it to the
# workspace. With this off, the file tools refuse paths outside the root and
# the shell escalates any command that names one — the shell cannot actually
# be confined, so the best it can do is stop and ask.
OPENMIRROR_UNCONFINED=false

# Money and secrets are a separate axis from OPENMIRROR_APPROVAL_MODE, on purpose.
# Both are ON: this is meant to be able to finish a task that ends at a
# checkout. Neither is ever automatic.
#
# A purchase is confirmed with you in EVERY mode — including `unrestricted`,
# and including an autopilot run nobody is watching. There is no setting that
# skips that prompt, deliberately: a setting like that is one somebody turns
# on during a demo and still has on six months later.
#
# Setting either to false makes it a refusal rather than a prompt, for an
# install that should not be able to do it at all.
OPENMIRROR_ALLOW_PURCHASES=true
# Typing a password, a card number or a one-time code. The value is kept out
# of the approval prompt, the transcript, the tool result and the page read.
# `browser_hand_over` is still the better move when you are at the keyboard:
# a value the agent never receives cannot leak from anywhere.
OPENMIRROR_ALLOW_CREDENTIALS=true
# Sending mail as you. A third axis rather than part of the mode ladder,
# because it is a different decision: reading an inbox is always allowed, and
# *answering* is what this gates. Every send is confirmed in every mode,
# including `unrestricted`, and a confirmed approval is never remembered for a
# message — a "yes" to one reply is not a "yes" to the next one.
# false turns a send into a refusal rather than a prompt, for an install that
# should not be able to put words in somebody else's inbox at all.
OPENMIRROR_ALLOW_MESSAGES=true

# --- hooks --------------------------------------------------------------------
# Commands that run around a tool call and can refuse it. The whole design is
# one asymmetry: a non-zero exit refuses, and nothing at all can turn a
# refusal into an approval. A project's hooks may therefore stop you doing
# things without being able to do them for you — see docs/HOOKS.md.
OPENMIRROR_HOOKS=true
# Whether a *project's* hooks may run without asking. Off by default: a
# hooks.json in a repository is code you did not write, and the first time
# one would fire you are shown the exact command and asked.
OPENMIRROR_HOOKS_ALLOW_PROJECT=false
# Seconds for one hook. A hook that misses this is reported and treated as
# having said nothing, and its whole process group is killed rather than the
# shell — a hook's children outlive the shell.
OPENMIRROR_HOOKS_TIMEOUT=10

# --- updates ------------------------------------------------------------------
# Ask GitHub whether there is a newer release. Once a day at most, and the
# answer is only ever shown: downloading waits for a button press and
# installing waits for a confirmation. A downloaded installer is checked
# against the SHA256 published in the same release — an integrity check, not a
# signature. See docs/UPDATES.md.
OPENMIRROR_UPDATE_CHECK=true
# Ask at start-up rather than waiting to be asked. Off by default: a process
# that makes a network call nobody asked for, before anybody has seen the
# window, is the behaviour people notice first and forgive last.
OPENMIRROR_UPDATE_CHECK_ON_START=false
#OPENMIRROR_UPDATE_DIR=./data/updates

# The model's context window, for the meter's percentage. 0 means "use what is
# known, and show a token count with no percentage" — which is the honest
# default, because a wrong denominator is a bar somebody makes decisions with.
#OPENMIRROR_CONTEXT_WINDOW=0

# --- mail -------------------------------------------------------------------
# Accounts live in a file of their own — data/mail.json, written 0600, and no
# route ever returns a password — so you can add one from the Mail tab without
# editing anything here or restarting. This switch is only whether the feature
# exists at all.
OPENMIRROR_MAIL=true

# A single account described entirely by the environment, folded into that file
# on first use. For an install managed by a file: the password is *referenced*
# by variable name rather than copied, so a second file never holds a second
# copy of a secret. Leave the hosts blank to add accounts from the interface
# instead.
#OPENMIRROR_MAIL_ADDRESS=you@example.com
#OPENMIRROR_MAIL_PASSWORD=an-app-password-not-your-account-password
#OPENMIRROR_MAIL_IMAP_HOST=imap.example.com
#OPENMIRROR_MAIL_SMTP_HOST=smtp.example.com
#OPENMIRROR_MAIL_LABEL=Work

# `jmap` to read and send over JMAP, `imap` to force IMAP, blank for whichever
# is configured. Both are supported per account and an account may have the two
# independently. JMAP is preferred where it is available — its `threadId` is
# the server's own answer to "which conversation is this", and a listing is
# one round trip instead of one per message — and `imap` is how you opt out of
# a host whose JMAP bridge is worse than its IMAP.
#OPENMIRROR_MAIL_PROTOCOL=

# --- calendar ---------------------------------------------------------------
# `.ics` files, read from a directory. Off by default: an empty directory
# offers nothing. Subscribing to a shared calendar needs a public `.ics` URL
# and a sidecar file next to the cache naming it.
OPENMIRROR_CALENDAR=false
#OPENMIRROR_CALENDAR_DIR=./data/calendars
# What counts as working hours, for "when am I free". In the server's local
# zone, which is right when the daemon runs on your own machine.
#OPENMIRROR_CALENDAR_START=09:00
#OPENMIRROR_CALENDAR_END=17:00

# --- the web ---------------------------------------------------------------
OPENMIRROR_WEB=true
# Letting it fetch loopback and link-local addresses would let a page it is
# reading reach things never exposed to the internet — a cloud metadata
# endpoint, or Perch's own console.
OPENMIRROR_WEB_ALLOW_PRIVATE=false

# headless | brave | tavily | searxng | duckduckgo
#
# `headless` is the default and needs no key: it drives a real browser, which
# is the only keyless path that still works now that the engines answer plain
# HTTP requests with a challenge page. It needs the browser extra
# (pip install 'openmirror[browser]' && playwright install chromium) and costs a
# Chromium, shared between searches and closed when idle.
#
# `duckduckgo` is the old keyless HTTP scraper. It is kept for a machine that
# can spare neither a key nor a browser, and as of testing it is blocked —
# html.duckduckgo.com answers automated requests with an anomaly page.
OPENMIRROR_SEARCH_BACKEND=headless
OPENMIRROR_SEARCH_KEY=
OPENMIRROR_SEARCH_URL=
# Which engine the headless backend asks: auto | startpage | duckduckgo | bing
# | google. `auto` tries them in that order — least-tracking first — and stops
# at the first that answers, because an engine being blocked is the ordinary
# case. Naming one uses only that one and fails loudly if it refuses: choosing
# an engine for what it does not log is not consent to fall through to one that
# does. Measured at the time of writing: Startpage and Bing answer, DuckDuckGo
# returns an error page to a headless browser, Google serves a challenge.
OPENMIRROR_SEARCH_ENGINE=auto

# --- agents, skills and the code -------------------------------------------
# Subagents: the `agent` tool, in the foreground and in the background. Every
# call a subagent makes is graded and asked about exactly like the session's
# own; what one costs is tokens, not permission.
OPENMIRROR_AGENTS=true
# Skills: the ones openmirror ships, yours (~/.openmirror/skills and
# ~/.claude/skills) and the project's (.openmirror/skills and .claude/skills,
# and a flat commands/ folder beside any of them). `/name` runs one.
OPENMIRROR_SKILLS=true
# Language servers, for the `lsp` tool and for errors after an edit. Only does
# anything where one is installed — rust-analyzer, basedpyright or pyright,
# pylsp, jedi-language-server, typescript-language-server, gopls, clangd — and
# the tool is not offered where none is. Add or switch off servers in a
# .lsp.json (this path, or .lsp.json in the directory the daemon starts in);
# see docs/EXTENDING.md.
OPENMIRROR_LSP=true
OPENMIRROR_LSP_CONFIG=
# When to summarise the conversation to make room, in estimated tokens. 0 is
# never, and `/compact` works either way. The default suits a large hosted
# model. For a local one, set it well under its context length — Ollama's
# num_ctx — because Ollama does not refuse an overlong prompt: it silently
# drops the beginning of it, and the first thing to go is the system prompt.
OPENMIRROR_COMPACT_AT=100000

# --- openmirror AS an MCP server -------------------------------------------
# The other direction from `.mcp.json`: another client — an editor, a desktop
# assistant, another agent — using this twin's memory, routing and search.
#
# Off, because memory is the most personal thing here and a twin on an open
# port is a liability rather than a feature. When it is on, the HTTP endpoint
# refuses to mount on a non-loopback bind without a token rather than warning
# about it. The stdio transport (`openmirror-mcp`) needs no token: a parent
# process that can spawn it already has everything it could hand over.
OPENMIRROR_MCP_SERVE=false
OPENMIRROR_MCP_SERVE_TOKEN=
# How much of the twin to lend out. `read` recalls, searches, fetches and
# researches; `write` adds remembering; `all` adds media generation, which
# spends money. Nothing at any scope runs a command, touches a file or drives
# the screen — those are the tools openmirror guards with a human in front of
# them, and an MCP call has no human in front of it.
OPENMIRROR_MCP_SERVE_SCOPE=read

# --- the desktop -----------------------------------------------------------
# Screenshot the screen and drive the mouse and keyboard. Off by default: it
# is the widest capability here and has the weakest safety net, because a
# click on a bitmap cannot be graded the way a click on a labelled DOM element
# can. Prefer the browser for anything that can be done in a browser.
OPENMIRROR_DESKTOP=false

# Where that happens, and it is the setting that decides whether you can keep
# using your computer while it works.
#
#   virtual  an X server of its own — its own pointer, its own keyboard, its
#            own windows. Applications are launched onto it by environment and
#            you watch through the frames it captures. This is the only
#            setting under which "it will not take your mouse" is a guarantee
#            rather than an intention. Needs Xvfb installed.
#   shared   the screen you are looking at. One pointer, and it moves it.
#   auto     virtual where it can, shared where it cannot, and it says which
#            in the log.
OPENMIRROR_DESKTOP_STAGE=auto
OPENMIRROR_DESKTOP_VIRTUAL_SIZE=1920x1080

# On a shared screen with more than one monitor, confine it to one. An index
# as X arranges them (1 is the first) or a name from xrandr. Everything
# outside that rectangle is neither captured nor clickable, and a coordinate
# outside it is refused rather than clamped — a clamped click lands on
# something real.
OPENMIRROR_DESKTOP_MONITOR=
OPENMIRROR_DESKTOP_DISPLAY=

# On a shared screen, stop the moment the pointer moves somewhere it was not
# left — which means a person has a hand on the mouse. The agent is told, and
# says so, rather than fighting for the cursor.
OPENMIRROR_DESKTOP_YIELD=true

# On Linux, a shared stage needs /dev/uinput writable on Wayland (add yourself
# to the "input" group) and libX11 and libXtst on X11. Wayland capture goes
# through the compositor's own screenshot tool — grim, cosmic-screenshot,
# gnome-screenshot or spectacle — because X11 grabbers return a black image
# there. macOS needs Screen Recording and Accessibility permission.

# --- the browser -----------------------------------------------------------
# Needs: pip install playwright && playwright install chromium
OPENMIRROR_BROWSER=false
# A real profile directory. Sign in to your sites here once, by hand; the
# agent inherits the sessions and never needs a password.
OPENMIRROR_BROWSER_PROFILE=~/.openmirror/browser
# Headful is worth it for anything transactional — you can watch it work and
# take the mouse off it.
OPENMIRROR_BROWSER_HEADLESS=true

# WHICH browser, for both the agent's browsing and headless search. These are
# the *default*: a choice made in the Browser dialog is saved to
# `browser.json` under the data directory and overrides them, so an install
# managed by this file behaves as it always did and nobody has to edit it and
# restart to try Chrome this afternoon.
#
# chromium | firefox | webkit — the engines Playwright installs.
OPENMIRROR_BROWSER_ENGINE=chromium
# An installed variant, chromium only: chrome | chrome-beta | msedge |
# msedge-beta | chromium-channel. Real Chrome has the codecs Chromium lacks and
# looks like an ordinary visitor to sites that check.
OPENMIRROR_BROWSER_CHANNEL=
# A Chromium-based binary by path — Brave, ungoogled-chromium, a distribution
# build. Wins over the channel above.
OPENMIRROR_BROWSER_BINARY=

# --- Perch: one host, one token, five services -----------------------------
# openmirror probes 11434 (Ollama), 8080 (whisper), 7860 (SD), 8188 (ComfyUI) and
# 8880 (Kokoro) and registers whichever answer as Perch,
# so a Perch with only chat switched on registers only chat.
PERCH_HOST=127.0.0.1
PERCH_TOKEN=
PERCH_SCHEME=http

# --- other providers -------------------------------------------------------
# These are the ones that can be set from the environment. Everything else —
# Groq, OpenRouter, Fireworks, Together, NanoGPT, DeepInfra, Cerebras,
# Mistral, xAI, Voyage, Google, LM Studio, vLLM, llama.cpp — is added from the
# Connections screen at runtime and kept in OPENMIRROR_CONNECTIONS below, so it can
# be changed without restarting a daemon that is in the middle of something.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# Keys the Connections screen will pick up if you have already set them, so
# connecting a service you were already configured for does not mean finding
# the key again.
GROQ_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
NANOGPT_API_KEY=
DEEPINFRA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=

# --- Tor -------------------------------------------------------------------
# Opt in per connection, from the Connections screen — never inferred from the
# proxy being up, because that would be a decision about where your prompts go
# made on your behalf. Needs: pip install "openmirror[tor]"
#
# Where the SOCKS proxy is. 9150 is Arti's default; the older C tor daemon
# uses 9050, and a failed probe checks for it and says so rather than
# reporting that nothing is listening.
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9150

# Open WebUI is itself a provider: it serves OpenAI's shapes at /api/v1, so
# pointing at it exposes every connection configured over there.
OPENWEBUI_BASE_URL=
OPENWEBUI_API_KEY=

# --- defaults --------------------------------------------------------------
OPENMIRROR_CHAT_MODEL=
OPENMIRROR_STT_MODEL=whisper-1
OPENMIRROR_TTS_MODEL=tts-1
OPENMIRROR_TTS_VOICE=alloy

# Refuse every provider that is not local hardware. Enforced when a route is
# resolved, not merely hidden in a UI: with it on, a local backend being down
# is an error rather than a quiet fallback to a hosted one.
OPENMIRROR_LOCAL_ONLY=false

# Which connection answers, per kind of request. Chat and embedding are named
# separately and deliberately: your questions go to one and your entire
# remembered history goes to the other, and a single "AI provider" setting is
# how someone ends up sending their memory to a vendor they picked for chat.
# Blank means "first provider that can", which prefers local hardware.
OPENMIRROR_CHAT_PROVIDER=
OPENMIRROR_EMBED_PROVIDER=
# The other four, named only when "first that can" is not the one you want —
# on a machine running Perch, any modality a hosted connection should answer
# instead. Each route's model is the matching default above (STT_MODEL,
# TTS_MODEL and TTS_VOICE), or the model named here.
OPENMIRROR_STT_PROVIDER=
OPENMIRROR_TTS_PROVIDER=
OPENMIRROR_IMAGE_PROVIDER=
OPENMIRROR_IMAGE_MODEL=
OPENMIRROR_VIDEO_PROVIDER=
OPENMIRROR_VIDEO_MODEL=

# Per-user vector memory. Two switches and both must be on: this one decides
# whether the feature exists on this install at all (off means the store is
# never even opened), and each person then opts in for themselves in the UI.
OPENMIRROR_MEMORY=false
OPENMIRROR_MEMORY_DB=./data/memory.db
# Which model turns text into vectors. Any provider registered for embeddings
# will do — Perch's, OpenAI's text-embedding-3-large, Gemini Embedding 2,
# Voyage's voyage-3-large, or Qwen3-Embedding 8B or 4B on your own hardware.
OPENMIRROR_EMBED_MODEL=
# Ask a truncatable model for shorter vectors. Cannot be changed under an
# existing store: vectors of different lengths cannot be compared, so old
# memories become unsearchable rather than wrong. 0 leaves it to the model.
OPENMIRROR_EMBED_DIMENSIONS=0

# --- the machine itself ----------------------------------------------------
# Installing software and changing system settings: system_info,
# package_search, package_install, package_remove, display_info, display_hdr.
# On, because a harness that can drive a browser but cannot install the
# program someone asked for is oddly shaped. Every call is graded and
# confirmed like any other — a system-wide install is `execute` because a
# package's install scripts run as root, a per-user one is `network`, and
# removing anything is `destructive`.
OPENMIRROR_SYSTEM=true

# --- generated media -------------------------------------------------------
# Images and video are written here as a file plus a JSON sidecar holding the
# prompt, the seed and every setting — because a picture you cannot reproduce
# is a picture you cannot iterate on.
OPENMIRROR_MEDIA_DIR=./data/media
OPENMIRROR_IMAGE_TIMEOUT=600
OPENMIRROR_VIDEO_TIMEOUT=1800

# Where connections added from the UI are kept. Written 0600; it holds keys.
OPENMIRROR_CONNECTIONS=./data/connections.json

# Keys for the image and video services, picked up when you connect one of the
# presets so you do not have to find the key twice. None of these is required
# and none of them is read unless a connection for that service exists.
#
# The two aggregators are the ones to start with if you only want one: between
# them they host most of the field, and both publish a schema per model, so the
# controls for anything they serve are the real ones.
REPLICATE_API_TOKEN=
FAL_KEY=
# First party, for the things a reseller drops on the way through.
BFL_API_KEY=            # FLUX, and Kontext for editing
STABILITY_API_KEY=
IDEOGRAM_API_KEY=       # the one to use when the picture has words in it
RECRAFT_API_KEY=        # real vectors rather than a raster that looks like one
RUNWAYML_API_SECRET=    # tagged reference images: @sarah in @warehouse
LUMAAI_API_KEY=         # camera language, and a frame to end on
MINIMAX_API_KEY=        # Hailuo, and the Director models' inline shot directions
# Kling signs a JWT rather than taking a bearer token, so its credential is two
# values. Enter it as access_key:secret_key — both are on its API keys page.
KLING_API_KEY=
# Sora rides on the OpenAI key above; Imagen and Veo ride on the Gemini one.

# --- the realtime voice API ------------------------------------------------
# OpenAI's speech-to-speech endpoint, used by Live mode. It is one vendor's
# service and cannot be pointed at local hardware — for a local voice call,
# ordinary Talk mode routes dictation, thinking and speech separately.
OPENMIRROR_REALTIME_MODEL=gpt-realtime
OPENMIRROR_REALTIME_VOICE=marin
# Until openmirror has accounts of its own, everything belongs to one person.
OPENMIRROR_USER=local

OPENMIRROR_LOG_LEVEL=INFO
