.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.env
dist/
build/
*.egg-info/

# Rust build output for the desktop shell (1.3 GB of it).
desktop/src-tauri/target/

# The frozen daemon the desktop app ships with, and PyInstaller's working
# files. Built per platform by desktop/sidecar/build.py and never committed: it
# is a binary that is only right for the machine that built it.
desktop/src-tauri/binaries/
desktop/sidecar/build/

# The default data directory (OPENMIRROR_DATA_DIR). Holds the memory database,
# rewind checkpoints, generated media and the saved browser choice — one
# person's data, none of it the project's. It was not listed here until an
# install actually ran from the repo root and left it untracked in `git
# status`, which is one `git add -A` away from publishing a memory store.
data/

# The VS Code extension's own build output, and whatever npm left behind
# trying to package it. The extension has no dependencies and no build step, so
# `node_modules/` should never appear at all; it is here for the day someone
# runs `npx` in that directory by hand.
ide/vscode/*.vsix
ide/vscode/node_modules/
ide/vscode/package-lock.json
